# Bright Data — get these from https://brightdata.com/cp/web_access
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
BRIGHTDATA_SERP_ZONE=serp_api1

# LLM for summarization + the grounding safety check. Pick ONE:
#
#  (a) Anthropic API key — simplest if someone on the team has one:
ANTHROPIC_API_KEY=
#
#  (b) AWS Bedrock — uses the AWS creds already on this machine (`aws configure`
#      or the event-provided account). Set USE_BEDROCK=true to enable.
USE_BEDROCK=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# With neither set, the service falls back to extractive summarization. That
# still works and is still safe, but patient-facing prose is noticeably worse.

# Cache TTL in seconds (default 6h). Demo content is pre-fetched, so this
# only affects fresh pulls.
CACHE_TTL_SECONDS=21600

PORT=8100
