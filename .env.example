DATABASE_URL=postgresql+psycopg://teama:teama@localhost:5432/team_a

# Disease area locked for the demo (see task checklist item 1)
DISEASE_AREA=type 2 diabetes
CLINICALTRIALS_CONDITION_QUERY=type 2 diabetes mellitus
OPENFDA_CONDITION_QUERY=type 2 diabetes

# Where raw payloads are stored before any transformation.
# Set RAW_STORAGE_BACKEND=s3 and fill in the bucket to use S3 instead of local disk.
RAW_STORAGE_BACKEND=local
RAW_STORAGE_DIR=./raw_data
S3_BUCKET=
AWS_REGION=us-east-1

# Public API safety boundary: set to true once Convoke (Team C) target/gene
# data starts flowing into the same tables, to prove /public/* still excludes it.
CONVOKE_DATA_PRESENT=false
